meta {
  name: Delete Film
  type: http
  seq: 5
}

delete {
  url: {{API_URL}}/film/{{FILM_ID}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{CLERK_TOKEN}}
}

docs {
  Deletes a film by its MongoDB ObjectId.

  Requires CLERK_TOKEN (returns 401 without it).

  This triggers cascading updates to:
  1. All associated directors' statistics
  2. Year statistics for the film's release year
  3. The top films list (the film is removed if present)
  4. The statistics of every actor in the film's cast

  Set the FILM_ID environment variable to test this endpoint.
}
