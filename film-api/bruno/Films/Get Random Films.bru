meta {
  name: Get Random Films
  type: http
  seq: 8
}

get {
  url: {{API_URL}}/random
  body: none
  auth: none
}

params:query {
  ~watched: true
  ~yearStart: 1990
  ~yearEnd: 2010
  ~genres: Drama,Crime
  ~count: 5
}

docs {
  Returns random films that match the specified criteria.

  Query Parameters:
  - watched: Filter by watched status (true/false)
  - yearStart: Start of year range (inclusive)
  - yearEnd: End of year range (inclusive)
  - genres: Filter by genres (comma-separated - film must have ANY of the listed genres)
  - count: How many films to return (default 5, 1 to 100)

  Note: Results are always filtered to owned films only.

  Returns fewer than count when not enough films match.

  Enable/disable query params by toggling the ~ prefix
}
