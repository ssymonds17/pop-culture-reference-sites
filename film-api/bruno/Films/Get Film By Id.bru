meta {
  name: Get Film By Id
  type: http
  seq: 3
}

get {
  url: {{API_URL}}/film/{{FILM_ID}}
  body: none
  auth: none
}

docs {
  Retrieves a single film by its MongoDB ObjectId, with the details that
  film lists leave out:
  - directors and cast actors populated
  - productionCompanies
  - tmdbCollection (the TMDb franchise, when the film belongs to one)

  Set the FILM_ID environment variable to test this endpoint.
}
