meta {
  name: Search
  type: http
  seq: 1
}

get {
  url: {{API_URL}}/search
  body: none
  auth: none
}

params:query {
  searchString: chaplin
  ~itemType:
}

docs {
  Search films, directors and actors by text.

  Query Parameters:
  - searchString: Text to search for (required)
  - itemType: Filter results by type (film | director | actor)

  If itemType is omitted, searches both films and directors. Actors are
  only searched when itemType is actor.

  Film search matches: title
  Director search matches: name
  Actor search matches: name (accent-insensitive, limit 200)
}
