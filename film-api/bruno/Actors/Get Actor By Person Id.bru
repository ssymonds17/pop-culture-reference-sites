meta {
  name: Get Actor By Person Id
  type: http
  seq: 2
}

get {
  url: {{API_URL}}/actor/{{TMDB_PERSON_ID}}
  body: none
  auth: none
}

docs {
  Retrieves an actor by their TMDb person ID, with a films array of every
  film they are credited in (newest first, directors populated).

  Set the TMDB_PERSON_ID environment variable to test this endpoint.

  Example TMDb person IDs:
  - 2963 (Nicolas Cage)
}
